.doclog <- new.env(parent = emptyenv())
.doclog$active <- FALSE
.doclog$student_id <- NULL
.doclog$session_id <- NULL
.doclog$doc_path <- NULL
.doclog$log_dir <- NULL
.doclog$snapshot_dir <- NULL
.doclog$log_file <- NULL
.doclog$manifest_file <- NULL
.doclog$summary_file <- NULL
.doclog$start_time <- NULL
.doclog$end_time <- NULL
.doclog$interval_sec <- 120
.doclog$last_hash <- NULL
.doclog$snapshots <- character()
now_chr <- function() {
format(Sys.time(), "%Y-%m-%d %H:%M:%S")
}
safe_norm <- function(x) {
normalizePath(x, winslash = "/", mustWork = FALSE)
}
ensure_dir <- function(path) {
if (!dir.exists(path)) dir.create(path, recursive = TRUE, showWarnings = FALSE)
}
get_rmd_path <- function() {
if (!rstudioapi::isAvailable()) {
stop("RStudio API is not available. Open this file in RStudio.")
}
ctx <- rstudioapi::getSourceEditorContext()
if (!is.null(ctx$path) && nzchar(ctx$path)) {
return(safe_norm(ctx$path))
}
ctx2 <- rstudioapi::getActiveDocumentContext()
if (!is.null(ctx2$path) && nzchar(ctx2$path)) {
return(safe_norm(ctx2$path))
}
stop("Could not determine the active .Rmd path.")
}
init_log_csv <- function(path) {
if (!file.exists(path)) {
template <- data.frame(
timestamp = character(),
student_id = character(),
session_id = character(),
event = character(),
detail = character(),
doc_path = character(),
file = character(),
stringsAsFactors = FALSE
)
write.csv(template, path, row.names = FALSE)
}
}
append_log <- function(event, detail = "", file = "") {
row <- data.frame(
timestamp = now_chr(),
student_id = .doclog$student_id,
session_id = .doclog$session_id,
event = event,
detail = detail,
doc_path = .doclog$doc_path,
file = file,
stringsAsFactors = FALSE
)
write.table(
row,
file = .doclog$log_file,
sep = ",",
row.names = FALSE,
col.names = FALSE,
append = TRUE
)
}
compute_hash <- function(path) {
if (!file.exists(path)) return(NA_character_)
unname(tools::md5sum(path))
}
snapshot_name <- function(doc_path) {
stamp <- format(Sys.time(), "%Y%m%d_%H%M%S")
stem  <- tools::file_path_sans_ext(basename(doc_path))
ext   <- tools::file_ext(doc_path)
file.path(.doclog$snapshot_dir, paste0(stem, "_", stamp, ".", ext))
}
record_manifest <- function(snapshot_file, hash, reason) {
row <- data.frame(
timestamp = now_chr(),
student_id = .doclog$student_id,
session_id = .doclog$session_id,
snapshot_file = safe_norm(snapshot_file),
source_file = .doclog$doc_path,
md5 = hash,
reason = reason,
stringsAsFactors = FALSE
)
if (!file.exists(.doclog$manifest_file)) {
write.csv(row, .doclog$manifest_file, row.names = FALSE)
} else {
write.table(
row,
file = .doclog$manifest_file,
sep = ",",
row.names = FALSE,
col.names = FALSE,
append = TRUE
)
}
}
take_snapshot <- function(reason = "scheduled", force = FALSE) {
if (!isTRUE(.doclog$active)) {
stop("Logger is not active.")
}
# ask RStudio to save open docs first
try(rstudioapi::documentSaveAll(), silent = TRUE)
if (!file.exists(.doclog$doc_path)) {
append_log("snapshot_skipped", "Document not found", .doclog$doc_path)
return(invisible(NULL))
}
current_hash <- compute_hash(.doclog$doc_path)
if (!force && identical(current_hash, .doclog$last_hash)) {
append_log("snapshot_unchanged", reason, .doclog$doc_path)
return(invisible(NULL))
}
out <- snapshot_name(.doclog$doc_path)
ok <- file.copy(.doclog$doc_path, out, overwrite = TRUE)
if (!ok) {
append_log("snapshot_failed", reason, out)
return(invisible(NULL))
}
.doclog$last_hash <- current_hash
.doclog$snapshots <- c(.doclog$snapshots, safe_norm(out))
record_manifest(out, current_hash, reason)
append_log("snapshot_saved", reason, out)
invisible(out)
}
schedule_snapshots <- function() {
tick <- NULL
tick <- function() {
if (!isTRUE(.doclog$active)) return(invisible(NULL))
take_snapshot("scheduled", force = FALSE)
later::later(tick, delay = .doclog$interval_sec)
}
later::later(tick, delay = .doclog$interval_sec)
append_log("autosnapshot_started",
paste("Snapshots scheduled every", .doclog$interval_sec, "seconds"))
}
start_doc_logger <- function(student_id = "student_001",
log_dir = "doclog",
interval_sec = 120) {
.doclog$student_id   <- student_id
.doclog$session_id   <- paste0(format(Sys.time(), "%Y%m%d_%H%M%S"), "_", sample(1000:9999, 1))
.doclog$doc_path     <- get_rmd_path()
.doclog$log_dir      <- safe_norm(log_dir)
.doclog$snapshot_dir <- safe_norm(file.path(log_dir, "snapshots"))
.doclog$log_file     <- safe_norm(file.path(log_dir, "activity_log.csv"))
.doclog$manifest_file<- safe_norm(file.path(log_dir, "snapshot_manifest.csv"))
.doclog$summary_file <- safe_norm(file.path(log_dir, "session_summary.json"))
.doclog$start_time   <- Sys.time()
.doclog$end_time     <- NULL
.doclog$interval_sec <- interval_sec
.doclog$last_hash    <- NA_character_
.doclog$snapshots    <- character()
.doclog$active       <- TRUE
ensure_dir(.doclog$log_dir)
ensure_dir(.doclog$snapshot_dir)
init_log_csv(.doclog$log_file)
append_log("session_started", "Logger started", .doclog$doc_path)
# initial saved copy
take_snapshot("initial", force = TRUE)
# begin 2-minute loop
schedule_snapshots()
invisible(.doclog$session_id)
}
log_checkpoint <- function(name) {
nm <- paste0("checkpoint_", gsub("[^A-Za-z0-9_]+", "_", tolower(name)))
append_log(nm, paste("Checkpoint:", name), .doclog$doc_path)
}
write_activity_report <- function() {
.doclog$end_time <- Sys.time()
summary_list <- list(
student_id = .doclog$student_id,
session_id = .doclog$session_id,
document = .doclog$doc_path,
start_time = format(.doclog$start_time, "%Y-%m-%d %H:%M:%S"),
end_time = format(.doclog$end_time, "%Y-%m-%d %H:%M:%S"),
elapsed_seconds = as.numeric(difftime(.doclog$end_time, .doclog$start_time, units = "secs")),
snapshot_interval_seconds = .doclog$interval_sec,
n_snapshots = length(.doclog$snapshots),
snapshots = .doclog$snapshots,
activity_log = .doclog$log_file,
manifest_file = .doclog$manifest_file
)
jsonlite::write_json(summary_list, .doclog$summary_file,
auto_unbox = TRUE, pretty = TRUE)
append_log("report_written", "Summary JSON written", .doclog$summary_file)
invisible(summary_list)
}
finish_doc_logger <- function() {
take_snapshot("final", force = TRUE)
append_log("session_finished", "Logger finished", .doclog$doc_path)
out <- write_activity_report()
.doclog$active <- FALSE
invisible(out)
}
# Start logging
start_doc_logger(student_id = "s12345", interval_sec = 120)
log_checkpoint("started")
x <- c(2,3,4,5,5)
sum(x)
plot(x)
log_checkpoint("tested code")
summary(x)
# Finish logging near the end of the session
log_checkpoint("finished")
finish_doc_logger()
get_wd()
getwd()
.doclog$summary_file
.doclog$log_file
.doclog$snapshot_dir
