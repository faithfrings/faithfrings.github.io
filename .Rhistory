#function to install R package if it has not been installed
install_if_missing <- function(pkg) {
if (!requireNamespace(pkg, quietly = TRUE)) {
install.packages(pkg)
}
}
install_if_missing("rstudioapi")
#function to install R package if it has not been installed
install_or_load <- function(pkg) {
if (!requireNamespace(pkg, quietly = TRUE)) {
install.packages(pkg)
}
library(pkg, character.only = TRUE)
}
install_or_load(later)
install_or_load("later")
install_or_load("jsonlite")
install_or_load("tools")
#function to install R package if it has not been installed and load if it has been installed. I think there is a package that does this, but I just like using this function.
install_or_load <- function(pkg) {
if (!requireNamespace(pkg, quietly = TRUE)) {
install.packages(pkg)
}
library(pkg, character.only = TRUE)
}
install_or_load("rstudioapi")
install_or_load("later")
install_or_load("jsonlite")
